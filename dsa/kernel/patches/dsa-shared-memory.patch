diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index b9c11f67..104771e6 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -661,4 +661,18 @@ source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
 source "drivers/misc/amd-sbi/Kconfig"
 source "drivers/misc/rp1/Kconfig"
+
+config DSA_SHARED_MEMORY
+	bool "DSA: host memory shared with the guest"
+	depends on MMU
+	default n
+	help
+	  The Desktop Subsystem for Android host shares memory with the
+	  guest for decoded video pictures and for graphics memory, instead
+	  of sending their bytes through a socket. This driver lets the codec
+	  HAL map the pictures, read only, through /dev/dsa_video_pictures,
+	  and each app map its own graphics allocations through
+	  /dev/dsa_graphics_memory, once init has written where they are.
+
+	  Unless you are building the DSA guest kernel, say N.
 endmenu
