diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index b9c11f67..104771e6 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -661,4 +661,18 @@ source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
 source "drivers/misc/amd-sbi/Kconfig"
 source "drivers/misc/rp1/Kconfig"
+
+config DSA_SHARED_MEMORY
+	bool "DSA: host memory shared with the guest for video pictures"
+	depends on MMU
+	default n
+	help
+	  The Desktop Subsystem for Android host decodes the guest's video
+	  on its own GPU and writes each picture into memory it shares with
+	  the guest, instead of sending it through a socket. This driver
+	  lets the guest's codec HAL map that memory, read only, through
+	  /dev/dsa_video_pictures, once init has written where it is to
+	  /sys/module/dsa_shared_memory/parameters/video_pictures.
+
+	  Unless you are building the DSA guest kernel, say N.
 endmenu
