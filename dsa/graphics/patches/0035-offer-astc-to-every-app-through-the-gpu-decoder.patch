+bool canDecodeAstcOnGpu(VulkanDispatch* vk, VkPhysicalDevice physicalDevice,
+                        std::string* missing) {
+    std::string lacks;
+    auto lack = [&lacks](const char* what) {
+        if (!lacks.empty()) {
+            lacks += ", ";
+        }
+        lacks += what;
+    };
+
+    // The decoded image is made mutable with VK_IMAGE_CREATE_EXTENDED_USAGE_BIT, so that the
+    // shader can write it as RGBA8UI while the app samples it as RGBA8 or sRGB: Vulkan 1.1.
+    VkPhysicalDeviceProperties props;
+    vk->vkGetPhysicalDeviceProperties(physicalDevice, &props);
+    if (props.apiVersion < VK_API_VERSION_1_1) {
+        lack("Vulkan 1.1");
+    }
+
+    // The decoding compute shader is recorded into the app's own command buffers, which run on
+    // a queue that draws.
+    uint32_t familyCount = 0;
+    vk->vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice, &familyCount, nullptr);
+    std::vector<VkQueueFamilyProperties> families(familyCount);
+    vk->vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice, &familyCount, families.data());
+    constexpr VkQueueFlags kDrawAndCompute = VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT;
+    bool drawsAndComputes = false;
+    for (const VkQueueFamilyProperties& family : families) {
+        if ((family.queueFlags & kDrawAndCompute) == kDrawAndCompute) {
+            drawsAndComputes = true;
+        }
+    }
+    if (!drawsAndComputes) {
+        lack("a queue family that both draws and computes");
+    }
+
+    // The app's ASTC blocks are copied into RGBA32UI images that the shader reads as storage
+    // images; it writes RGBA8UI storage images, which the app then samples, filtered, as RGBA8
+    // or sRGB, and copies from.
+    struct Need {
+        VkFormat format;
+        VkFormatFeatureFlags features;
+        const char* what;
+    };
+    const Need needs[] = {
+        {VK_FORMAT_R32G32B32A32_UINT,
+         VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT,
+         "RGBA32UI storage images that copies write"},
+        {VK_FORMAT_R8G8B8A8_UINT, VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT, "RGBA8UI storage images"},
+        {VK_FORMAT_R8G8B8A8_UNORM,
+         VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+             VK_FORMAT_FEATURE_TRANSFER_SRC_BIT,
+         "filtered RGBA8 sampling"},
+        {VK_FORMAT_R8G8B8A8_SRGB,
+         VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+             VK_FORMAT_FEATURE_TRANSFER_SRC_BIT,
+         "filtered sRGB sampling"},
+    };
+    for (const Need& need : needs) {
+        VkFormatProperties formatProps = {};
+        vk->vkGetPhysicalDeviceFormatProperties(physicalDevice, need.format, &formatProps);
+        if ((formatProps.optimalTilingFeatures & need.features) != need.features) {
+            lack(need.what);
+        }
+    }
+
+    if (missing) {
+        *missing = lacks;
+    }
+    return lacks.empty();
+}
 
