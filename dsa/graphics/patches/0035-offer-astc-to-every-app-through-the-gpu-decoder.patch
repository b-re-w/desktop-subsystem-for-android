+    // Unlinks every struct of `sType` from the pNext chain after `head`. An image of a format
+    // the device emulates is made, viewed and queried in other formats (the decoded RGBA8 and
+    // the RGBA32UI blocks), so a VkImageFormatListCreateInfo naming the app's compressed formats
+    // would list formats those images cannot be viewed as, and leave out the ones the decoding
+    // shader reads and writes them through; without the list, a mutable image may be viewed in
+    // every compatible format. The structs stay where they are; only the links around them
+    // change.
+    static void dropFromChain(void* head, VkStructureType sType) {
+        auto* current = reinterpret_cast<vk_struct_common*>(head);
+        while (current->pNext) {
+            if (current->pNext->sType == sType) {
+                current->pNext = current->pNext->pNext;
+            } else {
+                current = current->pNext;
+            }
+        }
+    }
