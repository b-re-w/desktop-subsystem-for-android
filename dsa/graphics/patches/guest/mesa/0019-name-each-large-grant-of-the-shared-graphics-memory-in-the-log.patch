+void ResourceTracker::forgetStagingLocked(const DeviceStaging& staging) {
+    // Unmapped before the host hears of the free, so it takes the granules back at once.
+    if (auto* shared = dsa::GraphicsMemoryDevice::get()) {
+        shared->unmap(staging.grant.ptr, staging.grant.offset, staging.grant.length);
+    }
+    dsa::driverMemoryLog().grantUnmapped(staging.grant.length);
+    logLargeGrant(false, staging.grant.length, staging.typeIndex, staging.typeFlags,
+                  staging.purpose.c_str());
+    logDriverMemory();
+}
