+// A grant over 16 MiB, made or let go of, on a line of its own (dsa_driver_memory.h).
+static void logLargeGrant(bool made, uint64_t bytes, uint32_t typeIndex, uint32_t typeFlags,
+                          const char* purpose) {
+    if (!dsa::isLargeGrant(bytes)) return;
+    char line[512];
+    dsa::largeGrantLine(line, sizeof(line), made, dsa::thisProcessName(), bytes, typeIndex,
+                        dsa::memoryTypeText(typeFlags).c_str(), purpose);
+    mesa_logi("%s", line);
+}
