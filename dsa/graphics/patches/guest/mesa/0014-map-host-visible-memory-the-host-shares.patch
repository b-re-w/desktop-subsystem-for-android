+
+bool ResourceTracker::askSharedMemory(VkEncoder* enc, VkDevice device) {
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkDevice.find(device);
+        if (it == info_VkDevice.end()) return false;
+        if (it->second.sharedMemoryAsked) return it->second.mapsSharedMemory;
+        it->second.sharedMemoryAsked = true;
+    }
+    const char* why = nullptr;
+    dsa::GraphicsMemoryDevice* shared = dsa::GraphicsMemoryDevice::get(&why);
+    bool maps = false;
+    if (shared) {
+        // With no memory: "this device maps the shared memory". A host that shares it answers
+        // with the region's id, which must be the one this guest's kernel maps.
+        uint64_t hello = 0;
+        uint64_t length = 0;
+        uint64_t regionId = 0;
+        const VkResult result = enc->vkGetMemoryHostAddressInfoGOOGLE(
+            device, VK_NULL_HANDLE, &hello, &length, &regionId, true /* do lock */);
+        maps = result == VK_SUCCESS && hello == dsa::kGraphicsMemoryHello &&
+               regionId == shared->info().regionId && length == shared->info().length;
+        if (!maps) why = "the host does not put this device's memory in the memory it shares";
+    }
+    static std::atomic<bool> said{false};
+    if (!said.exchange(true)) {
+        if (maps) {
+            mesa_logi("host-visible memory is mapped from %" PRIu64
+                      " MiB the host shares, where the host puts it",
+                      shared->info().length >> 20);
+        } else {
+            mesa_logi("host-visible memory is copied through the stream: %s", why);
+        }
+    }
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkDevice.find(device);
+    if (it != info_VkDevice.end()) it->second.mapsSharedMemory = maps;
+    return maps;
+}
