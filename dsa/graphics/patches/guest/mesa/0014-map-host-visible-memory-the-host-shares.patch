+uint8_t* ResourceTracker::mapSharedMemory(VkEncoder* enc, VkDevice device, VkDeviceMemory memory,
+                                          uint64_t* offset, uint64_t* length) {
+    if (!askSharedMemory(enc, device)) return nullptr;
+    dsa::GraphicsMemoryDevice* shared = dsa::GraphicsMemoryDevice::get();
+    if (!shared) return nullptr;
+    uint64_t key = 0;
+    // The host answers only for memory it put in the shared memory; the rest is copied.
+    if (enc->vkGetMemoryHostAddressInfoGOOGLE(device, memory, offset, length, &key,
+                                              true /* do lock */) != VK_SUCCESS) {
+        return nullptr;
+    }
+    uint8_t* mapped = shared->map(*offset, *length, key);
+    if (!mapped) {
+        static std::atomic<bool> said{false};
+        if (!said.exchange(true)) {
+            mesa_loge("the kernel would not map a grant of the memory the host shares (offset "
+                      "%" PRIu64 ", %" PRIu64 " bytes); that memory is copied through the stream",
+                      *offset, *length);
+        }
+        // The host has the memory in the region either way, and a copy works there as well.
+        return nullptr;
+    }
+    return mapped;
