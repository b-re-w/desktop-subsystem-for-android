+// DSA: the bytes a CPU upload or read back of `width` x `height` pixels in `format` and `type`
+// touches, rows padded to 4 bytes as GL's default alignment pads them, or 0 for a format a
+// DSA guest never sends. A DSA guest's packed YUV planes (kDsaPackedYuvFormat) are `width`
+// bytes on one row.
+static uint64_t dsaPixelBytes(GLint width, GLint height, GLenum format, GLenum type) {
+    if (width <= 0 || height <= 0) return 0;
+    // GL_RGBA, GL_BGRA_EXT, GL_RGB, GL_LUMINANCE; GL_UNSIGNED_BYTE, GL_UNSIGNED_SHORT_5_6_5,
+    // GL_HALF_FLOAT, GL_UNSIGNED_INT_2_10_10_10_REV.
+    constexpr GLenum kRgba = 0x1908, kBgra = 0x80E1, kRgb = 0x1907, kLuminance = 0x1909;
+    constexpr GLenum kUnsignedByte = 0x1401, k565 = 0x8363, kHalfFloat = 0x140B,
+                     k2101010 = 0x8368;
+    uint64_t bytes = 0;
+    if (type == kUnsignedByte) {
+        bytes = format == kRgba || format == kBgra ? 4
+                : format == kRgb                   ? 3
+                : format == kLuminance             ? 1
+                                                   : 0;
+    } else if (type == k565 && format == kRgb) {
+        bytes = 2;
+    } else if (type == kHalfFloat && format == kRgba) {
+        bytes = 8;
+    } else if (type == k2101010 && format == kRgba) {
+        bytes = 4;
+    }
+    const uint64_t row = (static_cast<uint64_t>(width) * bytes + 3) / 4 * 4;
+    return row * static_cast<uint64_t>(height);
+}
+
+// DSA: whether the pixels of a DMA call lie inside a staging grant of the graphics memory
+// shared with the guest that belongs to the calling guest process, so a process can make the
+// renderer read or write only its own memory there (dsa_graphics_memory.h).
+static bool dsaOwnsPixels(const void* pixels, uint32_t pixels_size, GLint width, GLint height,
+                          GLenum format, GLenum type) {
+    const uint64_t needed = dsaPixelBytes(width, height, format, type);
+    RenderThreadInfo* info = RenderThreadInfo::get();
+    if (!pixels || needed == 0 || needed > pixels_size || !info ||
+        !dsa::graphicsMemory().owns(pixels, needed, info->m_puid)) {
+        static std::atomic<bool> said{false};
+        if (!said.exchange(true)) {
+            WARN("graphics memory: a guest process named pixels outside its own staging memory "
+                 "(%u bytes for %dx%d); the copy is refused",
+                 pixels_size, width, height);
+        }
+        return false;
+    }
+    return true;
+}
