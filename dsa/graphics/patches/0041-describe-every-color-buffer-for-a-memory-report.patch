+std::vector<FrameBuffer::ColorBufferDescription> FrameBuffer::describeColorBuffers() {
+    std::vector<ColorBufferDescription> out;
+    {
+        AutoLock mutex(m_lock);
+        AutoLock colorBufferMapLock(m_colorBufferMapLock);
+        std::unordered_map<HandleType, size_t> index;
+        out.reserve(m_colorbuffers.size());
+        for (const auto& [handle, ref] : m_colorbuffers) {
+            ColorBufferDescription d;
+            d.handle = handle;
+            if (ref.cb) {
+                d.width = ref.cb->getWidth();
+                d.height = ref.cb->getHeight();
+                d.format = static_cast<uint32_t>(ref.cb->getFormat());
+                d.frameworkFormat = static_cast<uint32_t>(ref.cb->getFrameworkFormat());
+            }
+            d.refcount = ref.refcount;
+            d.opened = ref.opened;
+            d.closedUs = ref.closedTs;
+            if (m_emulationVk) {
+                VkDeviceSize size = 0;
+                if (m_emulationVk->getColorBufferAllocationInfo(handle, &size, nullptr, nullptr,
+                                                                nullptr)) {
+                    d.allocationBytes = size;
+                }
+            }
+            index[handle] = out.size();
+            out.push_back(std::move(d));
+        }
+        for (const auto& [puid, handles] : m_procOwnedColorBuffers) {
+            for (HandleType handle : handles) {
+                const auto found = index.find(handle);
+                if (found != index.end()) {
+                    out[found->second].holders.push_back(puid);
+                }
+            }
+        }
+        std::lock_guard<std::mutex> historyLock(m_colorBufferHistoryLock);
+        for (auto it = m_colorBufferHistory.begin(); it != m_colorBufferHistory.end();) {
+            const auto found = index.find(it->first);
+            if (found == index.end()) {
+                it = m_colorBufferHistory.erase(it);
+                continue;
+            }
+            out[found->second].creatorPuid = it->second.creatorPuid;
+            out[found->second].createdUs = it->second.createdUs;
+            out[found->second].lastPostUs = it->second.lastPostUs;
+            ++it;
+        }
+    }
+    // The displays' table has its own lock, which a post takes without m_lock.
+    for (auto& d : out) {
+        uint32_t displayId = 0;
+        if (getColorBufferDisplay(d.handle, &displayId) == 0) {
+            d.displayId = displayId;
+        }
+    }
+    return out;
+}
