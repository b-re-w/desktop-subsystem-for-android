+uint64_t CompositorVk::yuvSamplingKey(const VkImageCreateInfo& image, const hwc_color_t& color) {
+    if (image.format != VK_FORMAT_G8_B8_R8_3PLANE_420_UNORM &&
+        image.format != VK_FORMAT_G8_B8R8_2PLANE_420_UNORM) {
+        return 0;
+    }
+    uint64_t model = VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_601;
+    uint64_t range = VK_SAMPLER_YCBCR_RANGE_ITU_NARROW;
+    bool swap = false;
+    if (color.a == kDsaYuvColorMarker && color.r >= 1 && color.r <= 3 && color.g >= 1 &&
+        color.g <= 2 && color.b <= 1) {
+        model = color.r == 1   ? VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_601
+                : color.r == 2 ? VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_709
+                               : VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_2020;
+        range = color.g == 1 ? VK_SAMPLER_YCBCR_RANGE_ITU_FULL : VK_SAMPLER_YCBCR_RANGE_ITU_NARROW;
+        swap = color.b == 1;
+    }
+    return static_cast<uint64_t>(image.format) | (model << kYuvKeyModelShift) |
+           (range << kYuvKeyRangeShift) | (swap ? kYuvKeySwapBit : 0) |
+           (image.tiling == VK_IMAGE_TILING_LINEAR ? kYuvKeyLinearBit : 0);
+}
+
+CompositorVk::YuvSampling* CompositorVk::getOrCreateYuvSampling(uint64_t key) {
+    auto found = m_yuvSamplings.find(key);
+    if (found != m_yuvSamplings.end()) {
+        return found->second.conversion != VK_NULL_HANDLE ? &found->second : nullptr;
+    }
+    // A key that cannot be sampled stays in the map empty, so it is tried once.
+    YuvSampling& sampling = m_yuvSamplings[key];
+
+    const VkFormat format = static_cast<VkFormat>(key & 0xffffffffull);
+    const VkImageTiling tiling =
+        (key & kYuvKeyLinearBit) ? VK_IMAGE_TILING_LINEAR : VK_IMAGE_TILING_OPTIMAL;
+    const VkFormatFeatureFlags features = getFormatFeatures(format, tiling);
+    const bool midpoint = features & VK_FORMAT_FEATURE_MIDPOINT_CHROMA_SAMPLES_BIT;
+    const bool cosited = features & VK_FORMAT_FEATURE_COSITED_CHROMA_SAMPLES_BIT;
+    if (!(features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT) || (!midpoint && !cosited) ||
+        m_vk.vkCreateSamplerYcbcrConversion == nullptr) {
+        ERR("CompositorVk cannot sample %s with tiling %s through a YCbCr conversion "
+            "(features %s); its layers are left out",
+            string_VkFormat(format), string_VkImageTiling(tiling),
+            string_VkFormatFeatureFlags(features).c_str());
+        return nullptr;
+    }
+    // Video 4:2:0 chroma sits on the left luma column and between two luma rows.
+    const VkChromaLocation xChroma =
+        cosited ? VK_CHROMA_LOCATION_COSITED_EVEN : VK_CHROMA_LOCATION_MIDPOINT;
+    const VkChromaLocation yChroma =
+        midpoint ? VK_CHROMA_LOCATION_MIDPOINT : VK_CHROMA_LOCATION_COSITED_EVEN;
+    const bool linear =
+        (features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_YCBCR_CONVERSION_LINEAR_FILTER_BIT) &&
+        (features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT);
+    const VkFilter chromaFilter = linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    // Without a separate reconstruction filter the sampler's filter must be the chroma's.
+    const VkFilter filter =
+        ((features &
+          VK_FORMAT_FEATURE_SAMPLED_IMAGE_YCBCR_CONVERSION_SEPARATE_RECONSTRUCTION_FILTER_BIT) &&
+         (features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT))
+            ? VK_FILTER_LINEAR
+            : chromaFilter;
+    // R is read as Cr and B as Cb. A buffer whose first chroma plane (or byte) is V has its
+    // R and B swapped.
+    const bool swap = key & kYuvKeySwapBit;
+    const VkSamplerYcbcrConversionCreateInfo conversionCi = {
+        .sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_CREATE_INFO,
+        .format = format,
+        .ycbcrModel = static_cast<VkSamplerYcbcrModelConversion>((key >> kYuvKeyModelShift) & 0xf),
+        .ycbcrRange = static_cast<VkSamplerYcbcrRange>((key >> kYuvKeyRangeShift) & 0xf),
+        .components = {swap ? VK_COMPONENT_SWIZZLE_B : VK_COMPONENT_SWIZZLE_IDENTITY,
+                       VK_COMPONENT_SWIZZLE_IDENTITY,
+                       swap ? VK_COMPONENT_SWIZZLE_R : VK_COMPONENT_SWIZZLE_IDENTITY,
+                       VK_COMPONENT_SWIZZLE_IDENTITY},
+        .xChromaOffset = xChroma,
+        .yChromaOffset = yChroma,
+        .chromaFilter = chromaFilter,
+        .forceExplicitReconstruction = VK_FALSE,
+    };
+    VkSamplerYcbcrConversion conversion = VK_NULL_HANDLE;
+    if (m_vk.vkCreateSamplerYcbcrConversion(m_vkDevice, &conversionCi, nullptr, &conversion) !=
+        VK_SUCCESS) {
+        ERR("CompositorVk could not make a YCbCr conversion for %s; its layers are left out",
+            string_VkFormat(format));
+        return nullptr;
+    }
+    const VkSamplerYcbcrConversionInfo conversionInfo = {
+        .sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_INFO,
+        .conversion = conversion,
+    };
+    const VkSamplerCreateInfo samplerCi = {
+        .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+        .pNext = &conversionInfo,
+        .magFilter = filter,
+        .minFilter = filter,
+        .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+        .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .mipLodBias = 0.0f,
+        .anisotropyEnable = VK_FALSE,
+        .maxAnisotropy = 1.0f,
+        .compareEnable = VK_FALSE,
+        .compareOp = VK_COMPARE_OP_ALWAYS,
+        .minLod = 0.0f,
+        .maxLod = 0.0f,
+        .borderColor = VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK,
+        .unnormalizedCoordinates = VK_FALSE,
+    };
+    VkSampler sampler = VK_NULL_HANDLE;
+    if (m_vk.vkCreateSampler(m_vkDevice, &samplerCi, nullptr, &sampler) != VK_SUCCESS) {
+        m_vk.vkDestroySamplerYcbcrConversion(m_vkDevice, conversion, nullptr);
+        ERR("CompositorVk could not make a YCbCr sampler for %s; its layers are left out",
+            string_VkFormat(format));
+        return nullptr;
+    }
+    const VkDescriptorSetLayoutBinding bindings[2] = {
+        VkDescriptorSetLayoutBinding{
+            .binding = 0,
+            .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT,
+            .pImmutableSamplers = &sampler,
+        },
+        VkDescriptorSetLayoutBinding{
+            .binding = 1,
+            .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
+            .descriptorCount = 1,
+            .stageFlags = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+            .pImmutableSamplers = nullptr,
+        },
+    };
+    const VkDescriptorSetLayoutCreateInfo setLayoutCi = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = static_cast<uint32_t>(std::size(bindings)),
+        .pBindings = bindings,
+    };
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    if (m_vk.vkCreateDescriptorSetLayout(m_vkDevice, &setLayoutCi, nullptr, &setLayout) ==
+        VK_SUCCESS) {
+        const VkPipelineLayoutCreateInfo pipelineLayoutCi = {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+            .setLayoutCount = 1,
+            .pSetLayouts = &setLayout,
+            .pushConstantRangeCount = 0,
+        };
+        if (m_vk.vkCreatePipelineLayout(m_vkDevice, &pipelineLayoutCi, nullptr,
+                                        &pipelineLayout) != VK_SUCCESS) {
+            pipelineLayout = VK_NULL_HANDLE;
+        }
+    } else {
+        setLayout = VK_NULL_HANDLE;
+    }
+    if (pipelineLayout == VK_NULL_HANDLE) {
+        if (setLayout != VK_NULL_HANDLE) {
+            m_vk.vkDestroyDescriptorSetLayout(m_vkDevice, setLayout, nullptr);
+        }
+        m_vk.vkDestroySampler(m_vkDevice, sampler, nullptr);
+        m_vk.vkDestroySamplerYcbcrConversion(m_vkDevice, conversion, nullptr);
+        ERR("CompositorVk could not make a YCbCr layout for %s; its layers are left out",
+            string_VkFormat(format));
+        return nullptr;
+    }
+    sampling.conversion = conversion;
+    sampling.sampler = sampler;
+    sampling.setLayout = setLayout;
+    sampling.pipelineLayout = pipelineLayout;
+    return &sampling;
+}
+
+VkPipeline CompositorVk::getOrCreateYuvPipeline(YuvSampling& sampling, VkFormat targetFormat) {
+    auto found = sampling.pipelines.find(targetFormat);
+    if (found != sampling.pipelines.end()) {
+        return found->second;
+    }
+    auto formatResources = m_formatResources.find(targetFormat);
+    if (formatResources == m_formatResources.end()) {
+        return VK_NULL_HANDLE;
+    }
+    VkPipeline pipeline =
+        createCompositionPipeline(sampling.pipelineLayout, formatResources->second.m_vkRenderPass);
+    sampling.pipelines[targetFormat] = pipeline;
+    return pipeline;
+}
+
+void CompositorVk::releaseYuvFrameResources(PerFrameResources* frameResources) {
+    if (!frameResources->m_yuvDescriptorSets.empty()) {
+        m_vk.vkFreeDescriptorSets(m_vkDevice, m_yuvDescriptorPool,
+                                  static_cast<uint32_t>(frameResources->m_yuvDescriptorSets.size()),
+                                  frameResources->m_yuvDescriptorSets.data());
+        frameResources->m_yuvDescriptorSets.clear();
+    }
+    for (VkImageView view : frameResources->m_yuvImageViews) {
+        m_vk.vkDestroyImageView(m_vkDevice, view, nullptr);
+    }
+    frameResources->m_yuvImageViews.clear();
+}
