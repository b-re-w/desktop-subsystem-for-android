+// DSA: the colour description a guest hwcomposer puts in a YUV buffer layer's colour, which
+// the compositor otherwise ignores for a buffer layer: red is the matrix (1 BT.601, 2 BT.709,
+// 3 BT.2020), green the range (1 full, 2 limited), blue 1 when the buffer's chroma planes are
+// in V, U order (YV12, NV21), and alpha this marker. A layer without it is BT.601, limited
+// range, in U, V order, as a video without a colour description usually is.
+namespace {
+constexpr uint8_t kDsaYuvColorMarker = 0x59;  // 'Y'
+constexpr uint64_t kYuvKeyModelShift = 32;
+constexpr uint64_t kYuvKeyRangeShift = 36;
+constexpr uint64_t kYuvKeySwapBit = 1ull << 40;
+constexpr uint64_t kYuvKeyLinearBit = 1ull << 41;
