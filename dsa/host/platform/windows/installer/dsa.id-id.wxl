<!-- The package's own words in Indonesian, for a package built with -culture id-ID. -->
<WixLocalization Culture="id-ID" Language="1057" xmlns="http://wixtoolset.org/schemas/v4/wxl">
    <String Id="ArpComments" Value="Desktop Subsystem for Android adalah proyek sumber terbuka yang independen. DSA tidak berafiliasi dengan, tidak didukung oleh, dan tidak disponsori oleh Microsoft maupun Google. Android adalah merek dagang Google LLC." />
    <String Id="SettingsShortcutDescription" Value="Pengaturan dan status Desktop Subsystem for Android" />
    <String Id="ApkFileType" Value="Paket aplikasi APK" />
    <String Id="ApkBundleType" Value="Bundel APK terpisah" />
