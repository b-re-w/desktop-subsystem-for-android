<?xml version="1.0" encoding="utf-8"?>
<!-- The package's own words in German, for a package built with -culture de-DE. -->
<WixLocalization Culture="de-DE" Language="1031" xmlns="http://wixtoolset.org/schemas/v4/wxl">
    <String Id="ArpComments" Value="Desktop Subsystem for Android ist ein unabhängiges Open-Source-Projekt. Es steht in keiner Verbindung zu Microsoft oder Google und wird von ihnen weder unterstützt noch gesponsert. Android ist eine Marke von Google LLC." />
    <String Id="SettingsShortcutDescription" Value="Einstellungen und Status von Desktop Subsystem for Android" />
    <String Id="ApkFileType" Value="APK-App-Paket" />
    <String Id="ApkBundleType" Value="Geteiltes APK-Bundle" />
</WixLocalization>
