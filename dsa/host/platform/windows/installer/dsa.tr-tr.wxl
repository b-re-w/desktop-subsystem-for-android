<!-- The package's own words in Turkish, for a package built with -culture tr-TR. -->
<WixLocalization Culture="tr-TR" Language="1055" xmlns="http://wixtoolset.org/schemas/v4/wxl">
    <String Id="ArpComments" Value="Desktop Subsystem for Android bağımsız bir açık kaynak projesidir. Microsoft veya Google ile bağlantılı değildir, onlar tarafından onaylanmamış ve desteklenmemektedir. Android, Google LLC'nin ticari markasıdır." />
    <String Id="SettingsShortcutDescription" Value="Desktop Subsystem for Android ayarları ve durumu" />
    <String Id="ApkFileType" Value="APK uygulama paketi" />
    <String Id="ApkBundleType" Value="Bölünmüş APK paketi" />
